<?xml version="1.0"?>
<!--
  Copy this file to Secrets.config (gitignored) and fill in the real value.
  appSettings file="Secrets.config" in Web.config merges these keys in at runtime;
  Secrets.config is intentionally not committed.
-->
<appSettings>
  <add key="SmtpSenderPassword" value="YOUR_SMTP_PASSWORD"/>
  <!-- Shared secret for backend<->relay system calls; must be the identical value in
       Tausend.UDPListener's Secrets.config. Generate with e.g.
       [System.BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes(32)... )
       or any 32+ byte random hex string. -->
  <add key="RelaySystemKey" value="YOUR_RELAY_SYSTEM_KEY"/>
</appSettings>
