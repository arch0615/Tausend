<?xml version="1.0"?>
<!--
  Copy this file to Secrets.config (gitignored) and fill in the real value.
  appSettings file="Secrets.config" in App.config merges these keys in at runtime;
  Secrets.config is intentionally not committed.
-->
<appSettings>
  <!-- Must be the identical value as Tausend.Core's Secrets.config RelaySystemKey -->
  <add key="RelaySystemKey" value="YOUR_RELAY_SYSTEM_KEY"/>
</appSettings>
